# MINDWATCH — Frontend Environment Variables
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local

# Supabase project URL (same as backend SUPABASE_URL)
# Found at: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to expose in the browser
# Found at: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastAPI backend base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time assessment/alert events
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
