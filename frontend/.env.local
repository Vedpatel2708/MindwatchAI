# =============================================================================
# frontend/.env.local.example
#
# PURPOSE: Template for all environment variables required by the Next.js
#          frontend. Copy this file to `.env.local` and fill in real values.
#

#   cp .env.local.example .env.local
#
# NEXT_PUBLIC_ prefix: variables with this prefix are exposed to the browser.
# Without it, the variable is only available server-side (in API routes).
# NEVER put secrets (private keys, service role keys) in NEXT_PUBLIC_ vars.
# =============================================================================

# --- Supabase (Frontend) ---
# Your Supabase project REST endpoint URL.
# Same value as SUPABASE_URL in the backend .env
# Found at: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://fltmzhzchhqlophmzgqa.supabase.co

# Your Supabase anon/public key — safe to expose in the browser.
# The anon key is intentionally public; Row Level Security (RLS) on the
# Supabase side controls what data this key can read/write.
# Found at: Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZsdG16aHpjaGhxbG9waG16Z3FhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1NjU1OTIsImV4cCI6MjA5NjE0MTU5Mn0.PalZuiTiCO6JR7DP2auZFFDEuDFX0MJ528gEXk_FLX4

# --- Backend API ---
# Base URL for the FastAPI backend REST API.
# During local development this is http://localhost:8000
# In production, replace with your deployed backend URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# WebSocket URL for real-time transaction/alert/report events.
# Must use ws:// (not wss://) for local development.
# In production with HTTPS, use wss:// instead.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
