# =============================================================================
# backend/.env.example
#
# PURPOSE: Template for all environment variables required by the backend.
#          Copy this file to `.env` and fill in your real values.
#
#   cp .env.example .env
#
# NEVER commit `.env` to git — it contains secrets.
# This `.env.example` file is safe to commit (contains only placeholders).
# =============================================================================

# --- Groq API ---
# Your Groq API key for LLM inference.
# Get it free at: https://console.groq.com → API Keys → Create Key
# Format: starts with "gsk_"
# Why Groq: delivers 300-800 tokens/sec on LPU hardware, free tier, no GPU needed.
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Supabase ---
# Your Supabase project REST endpoint URL.
# Found at: Supabase Dashboard → Settings → API → Project URL
# Format: https://<your-project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase project's anon/public key.
# Found at: Supabase Dashboard → Settings → API → Project API Keys → anon public
# This key is safe to use in backend code — Row Level Security (RLS) policies
# control what data this key can access.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Fraud Detection Config ---
# The fraud score threshold above which a transaction is flagged and triggers
# an alert and agent investigation. Range: 0.0 to 1.0
# Default: 0.70 (flag transactions with >70% predicted fraud probability)
# Lower = more sensitive (more alerts), Higher = more specific (fewer alerts).
FRAUD_THRESHOLD=0.70

# Path to the serialized ML model file produced by backend/ml/train.py.
# After running train.py, the best model is saved here.
# This path is relative to the backend/ directory.
MODEL_PATH=models/fraud_model.joblib
